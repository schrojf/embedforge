# Copy to .env for local development. Production should set these as real
# environment variables instead. Full reference: docs/configuration.md

EMBEDFORGE_ENV=dev
EMBEDFORGE_LOG_FORMAT=console
EMBEDFORGE_LOG_LEVEL=DEBUG

# Bind address. Use 0.0.0.0 only inside a container.
EMBEDFORGE_HOST=127.0.0.1
EMBEDFORGE_PORT=8000

# Set to false to skip tokens entirely while developing locally.
EMBEDFORGE_AUTH_ENABLED=true
EMBEDFORGE_TOKENS_FILE=data/tokens.json

EMBEDFORGE_MODEL_ID=dev-hash
EMBEDFORGE_MODEL_DIR=data/models

# Concurrency. See docs/performance.md before changing these.
EMBEDFORGE_INFERENCE_WORKERS=1
EMBEDFORGE_MAX_BATCH_SIZE=32
EMBEDFORGE_BATCH_WAIT_MS=5
EMBEDFORGE_QUEUE_MAX_SIZE=512
